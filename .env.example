# JD Parfum — isolated credentials (do NOT copy live AmirCars secrets)
SUPABASE_URL=https://YOUR_JD_PARFUM_PROJECT.supabase.co
SUPABASE_KEY=sb_publishable_replace_me_jd_parfum
# Optional: server-only. Leave blank to rely on anon RLS (sql/006_public_catalog_anon.sql)
SUPABASE_SERVICE_ROLE_KEY=
FLASK_SECRET_KEY=replace_with_64_byte_hex_jd_parfum_only
CLOUDINARY_URL=cloudinary://JD_API_KEY:JD_API_SECRET@JD_CLOUD_NAME
# Alternativa en Render (si no usa CLOUDINARY_URL):
# CLOUDINARY_CLOUD_NAME=jd_parfum_cloud
# CLOUDINARY_API_KEY=jd_api_key
# CLOUDINARY_API_SECRET=jd_api_secret
FLASK_DEBUG=0
FORCE_HTTPS=true
COOKIE_SECURE=true

# Render: servicio jd-parfum → configure Environment secrets in the panel, never in git.
